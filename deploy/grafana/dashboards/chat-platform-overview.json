  "templating": {
    "list": [
      {
        "name": "region",
        "label": "region",
        "type": "query",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(region)",
        "query": {
          "qryType": 1,
          "query": "label_values(region)",
          "refId": "regionQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "shard",
        "label": "shard",
        "type": "query",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(shard)",
        "query": {
          "qryType": 1,
          "query": "label_values(shard)",
