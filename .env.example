# Copy to .env and adjust as needed. docker-compose.yml reads these directly.

POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat

CONTROL_DSN=postgres://chat:chat@postgres-control:5432/chat?sslmode=disable
SHARD_A_DSN=postgres://chat:chat@postgres-shard-a:5432/chat?sslmode=disable
SHARD_B_DSN=postgres://chat:chat@postgres-shard-b:5432/chat?sslmode=disable

VALKEY_ADDR=valkey:6379
# Sentinel-managed HA (deploy/docker-compose.yml's valkey-sentinel-* +
# valkey-replica): api/gateway connect through Sentinel and follow
# failover automatically, rather than pinning to VALKEY_ADDR directly.
# Clear this (leave blank) to fall back to plain VALKEY_ADDR, e.g. for a
# minimal single-node local setup.
VALKEY_SENTINEL_ADDRS=valkey-sentinel-1:26379,valkey-sentinel-2:26379,valkey-sentinel-3:26379
VALKEY_MASTER_NAME=mymaster
KAFKA_BROKERS=kafka:9092

# HMAC secret used to sign/verify dev auth tokens (see docs/platform/security.md).
# Generate your own for anything beyond local development:
#   openssl rand -hex 32
AUTH_SECRET=dev-local-only-secret-change-me

SHARDS_CONFIG=/etc/chat/shards.yaml

# Browser origins allowed to call the api service directly (comma-separated).
# Defaults to http://localhost:3000 (the demo app's Next.js dev server) if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
