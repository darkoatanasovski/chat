# Copy to .env and adjust as needed. deploy/docker-compose.yml reads these.
# In the cell model, per-service DSNs (CONFIG_DSN/CELL_DSN), Kafka and Valkey
# addresses are set directly in docker-compose.yml from the service names, so
# they no longer live here — only the shared secrets/credentials do.

POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat

# HMAC secret used to sign/verify dev auth tokens (see docs/platform/security.md)
# AND by the router to verify inbound tokens — must be identical across the
# router and every cell service. Generate your own beyond local dev:
#   openssl rand -hex 32
AUTH_SECRET=dev-local-only-secret-change-me

# Encrypts app credential secrets at rest (internal/platform/secretbox) so
# they can be revealed again from the console after the one-time "shown once"
# response is gone. Must decode to exactly 32 bytes. Generate your own:
#   openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=ZGV2LWxvY2FsLW9ubHkta2V5LTMyLWJ5dGVzLW9rISE=

# Optional: Azure Translator (the "translations" capability). Empty = disabled.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
