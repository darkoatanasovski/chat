# Public (NEXT_PUBLIC_*) config baked into the client bundle at build time.
# API traffic goes through the Cloudflare edge Worker, which routes to Railway.
NEXT_PUBLIC_API_BASE=https://chat-edge-router.reedee.workers.dev
NEXT_PUBLIC_GATEWAY_BASE=wss://chat-edge-router.reedee.workers.dev
NEXT_PUBLIC_SITE_URL=https://chat-console.reedee.workers.dev
NEXT_PUBLIC_GRAFANA_URL=
